# Firebase Configuration (get from Firebase Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Web Push certificate: Firebase Console -> Project settings -> Cloud Messaging
# -> Web configuration -> Generate key pair. This is a PUBLIC key; shipping it
# in the bundle is correct. Without it push simply stays unavailable — it is
# deliberately NOT in REQUIRED_ENV, which is for values whose absence renders a
# blank white page.
VITE_FIREBASE_VAPID_KEY=

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=

# AI (optional)
GEMINI_API_KEY=
