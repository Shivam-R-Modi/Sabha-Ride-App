rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =====================================
    // HELPER FUNCTIONS
    // =====================================
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Get user's profile data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // hasRole(role) and isApproved() lived here. Both had zero call sites — every
    // rule goes through isManager/isDriver/isStudent below, which inline the same
    // tests. Two more getUserData() lookups nothing reached.

    // A role counts however the document happens to record it.
    //
    // The same three-way test was spelled out separately inside isManager,
    // isDriver and isStudent (and twice more in dead helpers), so the four role
    // fields could drift apart one helper at a time — which is exactly what
    // happened on the server, where five hand-written copies disagreed.
    //
    // `activeRole` is deliberately NOT consulted. It records which hat the user is
    // wearing in the UI, not what they may do, and it is listed in
    // touchesPrivilegeFields() below — so a user cannot write it, the RoleSwitcher
    // only ever changes React state, and the stored value stays frozen at whatever
    // signup wrote. Authorising on a field the app cannot keep current is how
    // manualAssignStudent ended up weaker than these rules.
    //
    // Mirrors recordedRoles() in src/roles.ts and functions/src/utils/roles.ts.
    function recordsRole(data, role) {
      return (data.role == role)
             || (data.registeredRole == role)
             || ('roles' in data && data.roles != null && role in data.roles);
    }

    // The hierarchy, expanded DOWNWARD only: a manager may act as a driver or a
    // student, a driver as a student. Nothing below manager ever implies it.
    function grantsRole(data, role) {
      return recordsRole(data, role)
             || (role == 'student' && (recordsRole(data, 'manager') || recordsRole(data, 'driver')))
             || (role == 'driver' && recordsRole(data, 'manager'));
    }

    function isApprovedAs(role) {
      let data = getUserData();
      return isAuthenticated()
             && grantsRole(data, role)
             && data.accountStatus == 'approved';
    }

    // Authority question — recorded, never inherited.
    //
    // Reads the user document every time, so a demotion takes effect on the very
    // next request. This is the DEFAULT deliberately: any rule that reaches for
    // "is this a manager?" and types isManager() gets the strict, instantly
    // revocable answer. Use it for every write, every delete, and for reads that
    // guard a secret.
    function isManager() {
      return isApprovedAs('manager');
    }

    // A manager's claim, if their ID token carries one.
    //
    // Read with get(..., false) so a token without the claim is false rather than
    // an error — which is what makes this safe to deploy before a single claim
    // exists: with none minted it is false everywhere, and isManagerForRead below
    // reduces exactly to isManager().
    function isManagerToken() {
      return isAuthenticated() && request.auth.token.get('mgr', false) == true;
    }

    // The cheap manager test, for READS AND LISTS ONLY.
    //
    // Every isManager() evaluation costs a billed get() of the caller's own user
    // document — on a list, once per document delivered. The claim is already on
    // the token and costs nothing, so the claim arm is checked first and
    // short-circuits the read for the common case.
    //
    // The trade being made explicitly: a custom claim lives on an ID token for up
    // to an hour after a demotion, so this is weaker than isManager() for exactly
    // that window. That is acceptable for reading a rider list and NOT acceptable
    // for deleting a user, changing a privilege field, or reading
    // settings/managerCode — all of which stay on isManager().
    //
    // The document arm is not a migration artefact to delete once claims are
    // minted. Two things must change first: updateUserStatus and the Database
    // Console's role editor are direct client writes with no claim sync, so the
    // document remains the only thing that reflects reality.
    function isManagerForRead() {
      return isManagerToken() || isManager();
    }

    // Capability questions — the hierarchy applies, which is what the old
    // isStudent() was reaching for when it listed registeredRole == 'manager' and
    // 'driver' by hand. isDriver() gains the same treatment it always should have
    // had: a manager who drives is a driver.
    // An approved manager who has been asked to run Airport Seva.
    //
    // WHAT THIS GATES, and what it cannot. It gates the coordinator-only writes and
    // the oversight surface. It does NOT hide the arrival board from a manager, and
    // no rule here could: grantsRole() expands manager downward to driver, so every
    // approved manager satisfies isApprovedAs('driver'), and the board is readable by
    // every approved Sarthi by design. A clause written to hide it would be defeated
    // by the driver arm OR'd beside it — which is exactly the shape of hole that let
    // a bare isDriver() list the whole rides collection.
    //
    // Built on isManager(), so it reads the document rather than the token: there is
    // no free fast path here, and a revoked manager loses it immediately.
    function isAirportCoordinator() {
      return isManager() && getUserData().get('airportCoordinator', false) == true;
    }

    function isDriver() {
      return isApprovedAs('driver');
    }

    function isStudent() {
      return isApprovedAs('student');
    }

    // Is the caller holding a car right now — i.e. driving tonight?
    //
    // ONE PERSON CANNOT BE BOTH DRIVER AND PASSENGER. The hierarchy above grants a
    // driver the student role and a manager both, deliberately, so a Sarthi can see
    // the rider screens. Nothing stopped them REQUESTING a ride there, and dispatch
    // would then assign them their own request: a phantom passenger holding a real
    // seat in their own car, their own address on the manifest, and a served count
    // that includes somebody who was never collected.
    //
    // Holding a car is the definition driverDoneForToday uses for "on shift",
    // because holding a car is exactly what lets a driver be assigned riders. Both
    // field names are read for the reason given in functions/src/utils/fleet.ts:
    // `currentVehicleId` is canonical and `currentCarId` is the server's older name
    // for the same thing.
    //
    // Ride requests are direct client writes with no callable in between, so this is
    // the boundary. The rider screen's "you are driving tonight" card is the
    // readable half, not the enforcement.
    function isHoldingAVehicle() {
      let data = getUserData();
      return data.get('currentVehicleId', null) != null
             || data.get('currentCarId', null) != null;
    }

    // Who a vehicle document says is holding it. Mirrors resolveVehicleHolder in
    // functions/src/utils/fleet.ts, which reads the same two fields in the same
    // order — so the rule and the callable cannot disagree about whose car it is.
    function vehicleHolder() {
      return resource.data.get('assignedDriverId', resource.data.get('currentDriverId', null));
    }

    // A driver may claim a car nobody holds, and release the one they hold. They may
    // not touch one somebody else is holding.
    //
    // This was `isDriver()` alone, unconditional, on both `cars` and `vehicles`, so
    // any approved driver could rewrite ANY vehicle document. The callable guards the
    // holder — globalAssignDriver refuses "Vehicle is assigned to another Sarthi" —
    // but assignVehicleToDriver writes the document straight from the browser and
    // never reaches it. Two Sarthis, one car, and the second one silently wins.
    function isFreeOrMine() {
      return vehicleHolder() == null || vehicleHolder() == request.auth.uid;
    }

    // isAssignedDriver(rideId) lived here. Its only caller was the /students
    // update rule, which is gone, so it was a billed get() that nothing reached.
    // A driver's authority over a ride is checked directly in the /rides rules.

    // =====================================
    // FIELD-LEVEL GUARDS
    //
    // isManager() derives authority from role/accountStatus inside the
    // caller's OWN document. Without these guards that is circular: a user
    // who can write those fields defines their own privileges, and a student
    // could become an approved manager in a single browser-console write.
    // =====================================

    // Which keys a write actually changes.
    //
    // This comment used to describe touchesPrivilegeFields() below, not this
    // function — a leftover from when the two were one thing.
    //
    // Note it dereferences `resource.data`, so it is UPDATE-ONLY: on a create there
    // is no existing document and the diff errors. Every caller is on an update path.
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // The same authority question, asked at CREATE time.
    //
    // Blocking privilege fields on update closed only half the hole: a brand-new
    // account has no document yet, so its first write is a create, and a create
    // could name any role and any accountStatus. One console call was enough to
    // arrive as an approved manager without ever seeing the access code.
    //
    // Students self-approve because that is the product decision — a student has
    // no authority over anyone. Every other role starts pending and is promoted
    // by a manager or by verifyManagerCode, both of which run with authority the
    // client does not have.
    function createsSelfApprovedStudentOnly() {
      let d = request.resource.data;
      return d.get('role', '') == 'student'
             && d.get('registeredRole', 'student') == 'student'
             && d.get('activeRole', 'student') == 'student'
             && (!('roles' in d) || d.roles.hasOnly(['student']));
    }

    function createsUnprivilegedProfile() {
      let d = request.resource.data;
      return !('platformRole' in d)
             && (d.get('accountStatus', 'pending') == 'pending'
                 || createsSelfApprovedStudentOnly());
    }

    function touchesPrivilegeFields() {
      return changedKeys().hasAny([
        'role', 'registeredRole', 'roles', 'activeRole',
        'accountStatus', 'platformRole',
        // Airport Seva's oversight flag. Self-appointment would hand somebody the
        // unclaimed-arrival alerts, the reassign control and the Airport scope of the
        // member export — which returns every traveller's date of birth, phone and
        // home address.
        //
        // Deliberately NOT in touchesRoleFields() below, so a manager may still set
        // it from the People tab with an audit row. Same reasoning as accountStatus:
        // it is one field, it means one thing, and a browser can write it atomically.
        // Identity lives in four fields at once and is a different problem.
        'airportCoordinator'
      ]);
    }

    // The four fields that say what somebody IS. A subset of the six above, and
    // separate from them because the two lists are refused to DIFFERENT people:
    // the six are what a user may not write about themselves, these four are what
    // NOBODY may write from a browser, manager included.
    //
    // Why a manager is refused a write they used to be trusted with: a role lives
    // in four fields and different readers read different ones — `roles[]` is what
    // the driver picker queries, `registeredRole` what the approval queues query.
    // The Records tab's raw editor writes them ONE AT A TIME, so `role: 'driver'`
    // with `roles: ['student']` produces one person who is a Sarthi to
    // recordsRole() here and invisible to the driver picker, with no field that
    // settles which is true. That shape has already shipped once: `roles:
    // ['manager']` at signup made every manager invisible to useAvailableDrivers,
    // so "assign to any driver" could only ever report none.
    //
    // A browser cannot make those four writes atomically, so it no longer makes
    // them at all. managerSetUserRole does, on the Admin SDK, which bypasses these
    // rules — and it also frees the demoted Sarthi's car and hands their assigned
    // riders back to the pool, neither of which a raw field edit was ever going to
    // remember to do.
    //
    // `accountStatus` is deliberately NOT here. It is one field, it means one
    // thing, and updateUserStatus in hooks/useUsers.ts writes it from the People
    // tab with an audit row. Approval is not the same problem as identity.
    function touchesRoleFields() {
      return changedKeys().hasAny(['role', 'registeredRole', 'roles', 'activeRole']);
    }

    // Turning ON your own airport-coordinator flag.
    //
    // Found by tests/rules/firestore.rules.test.ts, and it is the OR'd-arm hole this
    // codebase keeps re-finding. `airportCoordinator` is in touchesPrivilegeFields()
    // so the OWNER arm below refuses it — but a manager IS the owner of their own
    // document, and the manager arm beside it only refuses touchesRoleFields(). So a
    // manager could appoint themselves in one write, and the coordinator gate on
    // /airportProfiles — every traveller's exact date of birth and family contact,
    // minors included — was one tap deep.
    //
    // Separation of duties instead: the flag must be granted BY SOMEBODY ELSE. Two
    // managers have to agree, which is what the compliance register wants of a grant
    // that unlocks that data.
    //
    // ASYMMETRIC ON PURPOSE. Setting it to true on yourself is refused; setting it to
    // false is allowed. You may always give up a privilege and never hand yourself
    // one — and a coordinator who wants to stop being woken at 5am must be able to
    // step down without finding somebody, or the control is dead.
    function selfGrantsAirportCoordinator(userId) {
      return isOwner(userId)
             && changedKeys().hasAny(['airportCoordinator'])
             && request.resource.data.get('airportCoordinator', false) == true;
    }

    // What a rider is allowed to say about wanting to become a Sarthi.
    //
    // The field grants nothing — a role change is refused above whatever this
    // says — so this is not an escalation guard. It is there because a rider who
    // could write `status: 'rejected'`, or a `decidedBy`, could make their own
    // profile and the manager's approval queue disagree about whether anyone had
    // looked at it. A request that appears to have answered itself is the
    // silently-does-nothing failure this app keeps having to remove.
    //
    // Clearing it is always allowed: `null` is how a rider withdraws a pending
    // request or dismisses a rejection they have read.
    function writesOwnRoleRequestOnly() {
      let d = request.resource.data;
      return !changedKeys().hasAny(['roleUpgrade'])
             || d.roleUpgrade == null
             || (d.roleUpgrade.keys().hasOnly(['status', 'requestedAt'])
                 && d.roleUpgrade.status == 'pending'
                 && d.roleUpgrade.requestedAt is string);
    }

    // Fields on a ride that the assignment pipeline owns. A student must not be
    // able to forge an assignment or shortcut completion — completeRide also
    // releases the vehicle, updates driver counters and sets student status, so
    // a client-side status write corrupts all three.
    function touchesRideServerFields() {
      return changedKeys().hasAny([
        'driverId', 'driver', 'driverName', 'carId', 'carModel', 'carColor',
        'carLicensePlate', 'route', 'peers', 'students', 'assignedStudentIds',
        'estimatedDistance', 'estimatedTime', 'assignedAt', 'startedAt',
        'completedAt', 'rideType',
        // The stamps the run itself writes. `arrivedAt` is what makes
        // sarthiArrived idempotent, so a rider who could set it would silence
        // their own "your Sarthi is outside". `nudges` holds the per-rider
        // cooldown, and clearing it is how you would turn one tap into twenty
        // buzzes. `noShowAt` records that somebody did not travel — the rider
        // it names is the last person who should be able to erase it.
        'arrivedAt', 'nudges', 'noShowAt',
        // Seats are set once, at create, and belong to the server from then on.
        // A rider able to raise seatsRequested after assignment would take places
        // from whoever was behind them; one able to write groupId or
        // groupSeatsTotal could attach themselves to another party's split, or
        // make their own request look half-served and inherit the priority that
        // real leftovers get. Editing while still waiting is lost with this — the
        // rider cancels and re-requests, which is worth avoiding a rule with a
        // status-dependent branch to get wrong.
        'seatsRequested', 'allowSplit', 'groupId', 'groupSeatsTotal', 'splitFromRideId'
      ]);
    }

    // Seats are optional, and absent means one — every ride written before seats
    // existed. Present, they must be a whole number in range. The stepper in
    // PickupForm already bounds this; a client-side bound is a suggestion.
    function hasValidSeats() {
      return !('seatsRequested' in request.resource.data)
             || (request.resource.data.seatsRequested is int
                 && request.resource.data.seatsRequested >= 1
                 && request.resource.data.seatsRequested <= 8);
    }

    // Statuses a student may set on their own ride. Everything else is the
    // server's to write.
    // `cancelled` is settable only FROM `requested`.
    //
    // The rules already permitted a rider to cancel; the UI never shipped a control
    // for it, so this was untested and unexercised. Adding the control tightened it:
    // once a Sarthi is assigned they are on their way, the seat is accounted for and
    // the manifest is built, so a rider vanishing from it silently is the wrong
    // outcome. Cancelling after assignment needs the seat released and the Sarthi
    // told, which is a separate job — not a status flip from a phone.
    function isStudentSettableStatus() {
      return !('status' in changedKeys())
             || request.resource.data.status == 'requested'
             || (request.resource.data.status == 'cancelled'
                 && resource.data.status == 'requested');
    }

    // =====================================
    // USERS COLLECTION
    // =====================================
    match /users/{userId} {
      // Profiles hold name, phone, email, home address and coordinates —
      // for minors as well as adults. Previously this was `isAuthenticated()`,
      // so any account that could sign up could read every family in the
      // database. Read is now self, or a manager.
      allow read: if isOwner(userId) || isManagerForRead();

      // Users create their own profile during registration, so role and
      // accountStatus are written by a client here — but only ever downward.
      // A self-approved student is fine; a self-approved manager or driver is
      // the escalation the update guard blocks, arriving one document earlier.
      // Managers are created by verifyManagerCode with the Admin SDK.
      allow create: if isOwner(userId) && createsUnprivilegedProfile();

      // A user may edit their own PROFILE fields only. All SIX privilege fields are
      // excluded — role, registeredRole, roles, activeRole, accountStatus,
      // platformRole — otherwise isManager() is circular and a student self-promotes
      // in one write. This comment used to name only four of them, which mattered:
      // `registeredRole` is one of the three fields recordsRole() reads, so a reader
      // checking the comment rather than touchesPrivilegeFields() would conclude
      // there was a hole. There is not; the function has always listed all six.
      //
      // The two `getUserData().role == 'manager'` clauses that used to be here
      // were removed deliberately: they bypassed the accountStatus == 'approved'
      // conjunct that isManager() applies, so an UNAPPROVED self-declared
      // manager had write access to every user document.
      // Two arms, and each now carries the guard that belongs to it. A user may
      // edit their own profile but not their privileges, and may ask to become a
      // Sarthi but not answer themselves. A manager may do everything a manager
      // did before EXCEPT write the four role fields, because those four have to
      // move together and a browser cannot do that — see touchesRoleFields().
      allow update: if (isOwner(userId)
                        && !touchesPrivilegeFields()
                        && writesOwnRoleRequestOnly())
                    || (isManager()
                        && !touchesRoleFields()
                        && !selfGrantsAirportCoordinator(userId));

      // Only approved managers can delete users.
      allow delete: if isManager();
    }
    
    // =====================================
    // MANAGER INVITES — server only
    // =====================================
    //
    // Closed to every client, managers included, in both directions.
    //
    // Read would expose the salt and hash of a live invite, and reading is how
    // settings/managerCode failed: any approved manager could fetch the plaintext
    // and mint managers indefinitely, with nothing recording that they had.
    // Write would let a manager forge an invite as somebody else, or clear
    // `usedBy` to make a spent code live again.
    //
    // createManagerInvite and redeemManagerInvite run under the Admin SDK, which
    // bypasses rules, so denying clients costs nothing at all.
    match /managerInvites/{inviteId} {
      allow read, write: if false;
    }

    // =====================================
    // STUDENTS / DRIVERS COLLECTIONS — legacy, closed
    // =====================================
    //
    // These were per-role mirrors of a user's profile. Nothing writes them any
    // more: no client and no Cloud Function creates or reads one, and the only
    // remaining references anywhere are the cleanup deletes in adminDeleteUser,
    // which run under the Admin SDK and so bypass these rules entirely.
    //
    // They previously carried `allow read: if isAuthenticated()` — the same hole
    // just closed on /users, and on the same data: name, phone, email and home
    // address, for minors as well as adults. Left open, anything that ever
    // repopulated them would silently republish every family to every account,
    // with no UI showing that it had happened.
    //
    // Closed rather than tightened, because a rule granting access to a
    // collection no code uses can only ever be a way in. If per-role documents
    // are wanted again, they belong under a real access rule written for the
    // read paths that need them.
    match /students/{studentId} {
      allow read, write: if false;
    }

    match /drivers/{driverId} {
      allow read, write: if false;
    }

    // =====================================
    // RIDES COLLECTION
    // =====================================
    match /rides/{rideId} {
      // Students can read their own rides (individual or grouped)
      // Drivers can read rides assigned to them
      // Managers can read all rides
      // Ride documents carry studentName, studentPhone, pickupAddress and
      // coordinates. The `isApproved()` clause that used to be here subsumed
      // every ownership check above it, so any approved account could read
      // every ride in the database — a list of names, phone numbers and home
      // addresses. Read is now genuinely scoped.
      allow read: if isManagerForRead()
                  || (resource.data.studentId != null && resource.data.studentId == request.auth.uid)
                  || (resource.data.assignedStudentIds != null && request.auth.uid in resource.data.assignedStudentIds)
                  || resource.data.driverId == request.auth.uid;

      // SCOPED, because `read` is `get` + `list` and allow rules are OR'd: an
      // unconditional arm here cannot be narrowed by the per-document `allow read`
      // above it. This carried a bare `isDriver()`, so every approved driver — and,
      // since the hierarchy makes a manager a driver, every manager without their
      // claim being checked — could list the WHOLE collection: every child's name,
      // phone number and pickup address, other drivers' rides included, and
      // completed ones from previous weeks.
      //
      // useDriverDashboard was doing exactly that and filtering in the browser, so
      // the leak was live rather than hypothetical.
      //
      // A driver's own rides are matched on `driverId` alone. `returnDriver` is
      // vestigial — nothing in the app or the functions has ever written it, because
      // the return leg is re-dispatched by home proximity rather than paired to the
      // outbound driver.
      allow list: if isManagerForRead()
                  || (request.auth != null
                      && resource.data.get('driverId', '') == request.auth.uid)
                  || (request.auth != null
                      && resource.data.get('studentId', '') == request.auth.uid);

      // A student may only create a ride for THEMSELVES, and only as a new
      // request — previously any student could forge a ride for another user,
      // or create one already marked 'assigned'.
      // NO BARE `isDriver()` ARM. It sat above the guarded student arm and OR
      // short-circuits, so a driver reached it first and none of the student
      // constraints applied — they could create a ride for any child, already marked
      // 'assigned', with seats out of bounds. The comment above describes exactly
      // that hole; the fix had been applied to the student arm only.
      //
      // Nothing needed it. The only client-side ride creation is a rider asking for
      // themselves (hooks/useRides.ts); drivers get work through globalAssignDriver,
      // which runs on the Admin SDK and bypasses these rules entirely. A Sarthi who
      // wants a lift now goes through the student arm, like anybody else — which is
      // the point of the hierarchy granting them that role.
      //
      // `isManager()` stays: the Raw records console creates ride documents directly.
      allow create: if isManager()
                    || (isStudent()
                        && request.resource.data.studentId == request.auth.uid
                        && request.resource.data.status == 'requested'
                        && hasValidSeats()
                        && !isHoldingAVehicle());

      // Students may cancel their own ride, but must not touch the fields the
      // assignment pipeline owns, nor set a status the server is responsible
      // for. Marking a ride 'completed' from the client would skip vehicle
      // release, driver counters and student status all at once.
      allow update: if isManager()
                    || (isDriver() && resource.data.driverId == request.auth.uid)
                    || (isStudent()
                        && resource.data.studentId == request.auth.uid
                        && !touchesRideServerFields()
                        && isStudentSettableStatus());

      // Only managers can delete rides
      allow delete: if isManager();
    }
    
    // =====================================
    // STATISTICS COLLECTION
    // =====================================
    match /statistics/{eventDate} {
      // Managers can read/write statistics
      // Others cannot access
      allow read: if isManagerForRead();
      // create + update, NOT `write`: that includes DELETE, and allow rules are OR'd
      // so a later `allow delete: if false` could not take it back — the hazard
      // storage.rules spells out. Statistics are the only record of what a sabha
      // actually did.
      allow create, update: if isManager();
      allow delete: if false;
    }
    
    // =====================================
    // SYSTEM & AUDIT LOGS COLLECTION
    // =====================================
    match /system/{docId} {
      // Drivers and students both render the current ride window from
      // system/rideContext, so read stays open to signed-in users.
      allow read: if isAuthenticated();

      // Write is DENIED to every client, including managers.
      //
      // These documents are derived state owned by Cloud Functions, which use
      // the Admin SDK and bypass rules entirely — so denying clients costs
      // nothing and closes two real holes:
      //
      //  - system/assignmentLock: globalAssignDriver computes
      //    lockAge = now - timestamp and only checks lockAge < TTL. Writing a
      //    far-future timestamp makes lockAge negative, which is always under
      //    the TTL, permanently blocking assignment for every driver on the
      //    platform. One document, one write.
      //  - system/rideContext: overwriting rideType flips every driver's route
      //    direction, or closes the service.
      //
      // Managers change the schedule through the callable, not by hand.
      allow write: if false;
    }

    // A `match /system/auditLogs/{logId}` block sat here granting managers
    // read and write. It could never match a document — that path is a
    // subcollection of the document `system/auditLogs`, which does not exist and
    // which nothing has ever written. Every audit row is in the top-level
    // collection below.

    match /auditLogs/{logId} {
      allow read: if isManagerForRead();

      // APPEND-ONLY. The previous rule was `allow write: if isManager()`, and
      // `write` covers update and delete — so a manager could edit or remove any
      // audit row, including the record of their own deletion. An audit trail that
      // its subject can rewrite is not an audit trail, and the console displays it
      // as though it were.
      //
      // The actor must be the caller: a manager could otherwise file a row under
      // a colleague's name. `managerId` is accepted alongside `actorUid` for one
      // release — the schema changed in the same deploy, and a browser sitting on
      // the previous bundle still sends the old field. logAuditAction swallows its
      // own failures, so an over-tight rule here would let a manager's edit
      // succeed silently unlogged, which is the exact outcome this block exists to
      // prevent. Drop the `managerId` arm once no old bundle can still be live.
      allow create: if isManager()
                    && request.resource.data.timestamp is string
                    && (request.resource.data.get('actorUid', '') == request.auth.uid
                        || request.resource.data.get('managerId', '') == request.auth.uid);

      // Cloud Functions close a 'pending' row with the Admin SDK, which bypasses
      // rules, so no client needs update.
      allow update, delete: if false;
    }

    // =====================================
    // NOTIFICATIONS COLLECTION
    // =====================================
    // =====================================
    // NOTIFICATIONS — closed, and the collection is not used
    // =====================================
    //
    // Nothing in this app reads or writes /notifications: no client, no Cloud
    // Function, no script. Push goes out through FCM (utils/notifications.ts), which
    // never stores anything here.
    //
    // The block that stood here was therefore dead — and it carried a live hole. Its
    // update rule gated on `resource.data.userId`, the EXISTING document, with no
    // constraint on the incoming one:
    //
    //     allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
    //
    // So the owner of a row could rewrite every field of it, `userId` included —
    // reassigning their own notification into somebody else's inbox and rewriting
    // its title and body on the way. A forged message from the app, to anyone.
    //
    // Closed rather than repaired, for the same reason the legacy students/ and
    // drivers/ mirrors above are closed: a rule granting access to a collection no
    // code uses can only ever be a way in. If in-app notifications are wanted later
    // they need a real access rule written for the read paths that will exist, not
    // this one revived.
    match /notifications/{notificationId} {
      allow read, write: if false;
    }

    
    // =====================================
    // CARS / VEHICLES COLLECTION
    // =====================================
    match /cars/{carId} {
      // Authenticated users can read car data
      allow read: if isAuthenticated();
      
      // Only managers can create cars
      allow create: if isManager();
      
      // Managers can move any car. A driver may claim a free one or release their
      // own — see isFreeOrMine(), which mirrors the callable's holder check.
      allow update: if isManager() || (isDriver() && isFreeOrMine());
      
      // Only managers can delete cars
      allow delete: if isManager();
    }

    match /vehicles/{vehicleId} {
      allow read: if isAuthenticated();
      allow create: if isManager();
      allow update: if isManager() || (isDriver() && isFreeOrMine());
      allow delete: if isManager();
    }
    
    // =====================================
    // WEEKLY ATTENDANCE COLLECTION
    // =====================================
    match /weeklyAttendance/{weekId} {
      allow read: if isAuthenticated();

      // The parent document is derived state, written only by the scheduler with
      // the Admin SDK. No client may create, change or DELETE it.
      //
      // This was previously silent — there was no write rule at all, so writes
      // failed by default. That accident was load-bearing: the Database Console
      // lists `weeklyAttendance` and renders delete and bulk-delete buttons for
      // it, and deleting the parent would leave every `responses/*` document
      // behind, invisible to a console that only lists parents. Stating the deny
      // turns the accident into the intention.
      allow write: if false;

      match /responses/{userId} {
        // Users can read and write their own response
        allow read: if isOwner(userId) || isManagerForRead();
        // create + update, NOT `write`. `write` includes DELETE, so a rider could
        // hard-delete their own answer and a manager anyone's — losing the record a
        // manager plans the evening from, with no audit row and nothing on screen to
        // say it had gone. Changing your mind is an update; there is no reason to
        // destroy the row.
        allow create, update: if isOwner(userId) || isManager();
        allow delete: if false;
      }
    }
    // =====================================
    // SABHA EVENTS
    // =====================================
    match /events/{eventId} {
      // Everyone signed in reads the calendar — the student dashboard shows when
      // the next sabha is, and the driver dashboard gates "Assign Me" on it.
      allow read: if isAuthenticated();

      // The agenda is long-form text written by a manager and shown on every
      // dashboard, and `editOccurrence`/`createOneOff` write this document
      // STRAIGHT FROM THE CLIENT — no callable in between. So this is the only
      // place the ceiling is actually enforced; the composer's own check exists
      // to give a readable message first.
      //
      // 2000 mirrors AGENDA_MAX_CHARS in src/utils/agenda.ts. Rules cannot import
      // it, so tests/quality/agenda-cap.test.ts fails if the two ever drift.
      //
      // Absence has to pass: a merge write that only touches times or status
      // never sends `agenda`, and requiring it would break editing a sabha.
      function agendaWithinLimit() {
        return !('agenda' in request.resource.data)
               || (request.resource.data.agenda is string
                   && request.resource.data.agenda.size() <= 2000);
      }

      // Managers schedule and move a gathering. Writing here changes when rides
      // open for the whole congregation, so it is the same authority as changing
      // the venue.
      allow create: if isManager() && agendaWithinLimit();
      allow update: if isManager() && agendaWithinLimit();

      // Deletion goes through the deleteSabhaEvent callable, NEVER directly —
      // including for managers.
      //
      // This was `allow write: if isManager()`, and `write` covers delete, so any
      // manager could already hard-delete a gathering with no cleanup at all.
      // Removing the event document does not remove what hangs off its date:
      // Firestore leaves `weeklyAttendance/{date}/responses/*` behind entirely,
      // and every read path for that data derives the id from
      // system/rideContext, so it becomes unreachable rather than merely untidy —
      // names, phone numbers and home addresses with no screen that can ever show
      // them again. Outstanding ride requests for the date also have to be
      // cancelled, or globalAssignDriver picks them up at the NEXT sabha.
      //
      // None of that can be expressed here: rules cannot enumerate a
      // subcollection, and cannot format a date in the venue's timezone to check
      // that the gathering is still in the future.
      allow delete: if false;
    }

    // =====================================
    // CLIENT ERROR REPORTS
    // =====================================
    //
    // Crash reports from the browser. Written by whoever crashed, read only by
    // managers — see src/utils/errorReport.ts for why this is a Firestore
    // collection rather than a third-party error service.
    match /clientErrors/{reportId} {
      // Any signed-in user may FILE one, because anyone can crash. Unauthenticated
      // is refused: an open write endpoint is a free way to fill the database, and
      // a report with no `uid` cannot help anybody anyway.
      //
      // `uid` is pinned to the caller. Without this, one signed-in user could file
      // reports attributed to another — noise that would send a manager chasing
      // the wrong person's phone.
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 500;

      // Reports are evidence. Nobody edits or deletes them from the client —
      // including the person who filed one, who could otherwise erase the trace
      // of a crash a manager is trying to understand. Pruning is an Admin SDK job.
      allow update, delete: if false;

      // Only managers, and only through the recorded-role path: this is the one
      // place a stack trace and a uid sit together, which is more than an ordinary
      // rider or driver has any reason to read.
      allow read: if isManagerForRead();
    }

    // =====================================
    // FEEDBACK — what people think of the app
    // =====================================
    //
    // Modelled on clientErrors above, and for the same reasons: anyone signed in
    // may file one because anyone may have something to say, the `uid` is pinned
    // to the caller, the size cap is enforced HERE and not only in the form
    // because a client is a trust boundary even when it belongs to a manager, and
    // nothing is editable afterwards.
    //
    // THE DOCUMENT ID IS THE THROTTLE. It is `{uid}_{YYYY-MM-DD}`, and `create`
    // only applies to a document that does not exist — so with `update` denied,
    // one person gets one submission per day, decided by the database rather than
    // by a counter in a browser that can be reloaded. No callable and no rate
    // limiter for it.
    //
    // The id is not verified against `uid` here. It does not need to be: `uid` is
    // pinned to the caller either way, so the worst a forged id achieves is
    // filing your OWN feedback under a different key, which costs nobody
    // anything. Requiring the two to match would mean string-building the date in
    // rules, which cannot be done reliably.
    //
    // 1000 mirrors MAX_FEEDBACK in src/utils/feedback.ts. Rules cannot import it,
    // so tests/quality/feedback-cap.test.ts fails if the two ever drift.
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 1000;

      // Append-only, including for the author and for managers. This is a record
      // of what somebody said; a manager who could edit it could soften a
      // complaint about themselves.
      allow update, delete: if false;

      // Managers only. Feedback may name a volunteer, so it is not for the
      // congregation to browse — and not for the author to re-read either, which
      // costs them nothing and keeps one rule instead of two.
      //
      // Deliberately does NOT touch `resource.data`: the manager's screen reads
      // this as a collection query, and a condition that inspects the document
      // makes the whole query fail. Same trap as the notices block below.
      allow read: if isManagerForRead();
    }

    // =====================================
    // NOTICES — the notice board
    // =====================================
    match /notices/{noticeId} {
      // Everyone signed in reads it: the board renders on the dashboard of all
      // three roles. Deliberately does NOT touch `resource.data`, which keeps it
      // list-safe — a condition that inspects the document makes a collection
      // query fail wholesale, and the board is read as a query.
      allow read: if isAuthenticated();

      // Managers author it, through the recorded-role path. `isManagerForRead()`
      // would accept a custom claim that survives a demotion for up to an hour,
      // which is fine for reading and not for writing.
      //
      // The size cap is here and not only in the composer, the same reasoning as
      // clientErrors above: a client is a trust boundary even when it belongs to
      // a manager. 4000 characters is a long flyer and nowhere near a payload.
      //
      // The title is constrained by SHAPE, not required to be present. Requiring
      // it here would make the two notices that predate the field — 2026-08-24 —
      // impossible to update from any client, including to correct them. The
      // callable is what requires one on the way in; this is what stops an
      // over-long or non-string one being stored.
      allow create, update: if isManager()
                            && request.resource.data.body is string
                            && request.resource.data.body.size() <= 4000
                            && (!('title' in request.resource.data)
                                || (request.resource.data.title is string
                                    && request.resource.data.title.size() <= 80));

      // Deleting a notice must also delete its image from Storage, and a client
      // cannot be trusted to do both. `deleteNotice` does it in order, and the
      // nightly sweep does it for expired ones. Same reasoning that makes
      // `events` undeletable from the client — a raw delete orphans something.
      allow delete: if false;
    }

    // =====================================
    // AIRPORT SEVA — arrivals board
    // =====================================
    //
    // A trip carries the traveller's name, date of birth, both phone numbers, their
    // destination address and their family's number. Every approved Sarthi can read
    // it, which is an OWNER DECISION taken on 2026-08-25 so that a Sarthi can decide
    // whether to volunteer and can confirm identity at an arrivals gate.
    //
    // That is deliberately the same shape as the hole closed on /rides on 2026-08-20,
    // so the two things that made it a hole are handled here rather than repeated:
    //
    //   1. `get` and `list` are SEPARATE rules. `read` is `get` + `list` and allow
    //      rules are OR'd, so a single `read` arm for Sarthis could not be narrowed
    //      by a per-document arm above it. A bare isDriver() on /rides read let every
    //      Sarthi list the whole collection.
    //   2. The arm is isApprovedAs('driver'), never isAuthenticated(). A pending or
    //      rejected account reads nothing.
    //
    // And the most sensitive field of all — the date of birth, which reverses
    // compliance decision D2 — is duplicated onto `passenger` here ONLY as much as a
    // Sarthi's card needs. The durable record it comes from is closed to them
    // entirely; see /airportProfiles below.
    //
    // `resource.data.get(field, default)` throughout, never bare field access: a
    // document missing the field would otherwise error the condition, and an errored
    // condition denies the whole query rather than that one document.
    match /airportPickups/{pickupId} {
      allow get: if isApprovedAs('driver')
                 || isManagerForRead()
                 || (request.auth != null
                     && resource.data.get('requesterUid', '') == request.auth.uid);

      // Scoped, and the traveller's own arm is filtered on `requesterUid` — the
      // board queries `arrivalAt` ranges, the rider's screen queries their own uid,
      // and each returned document satisfies its own arm.
      allow list: if isApprovedAs('driver')
                  || isManagerForRead()
                  || (request.auth != null
                      && resource.data.get('requesterUid', '') == request.auth.uid);

      // NOTHING is written from a browser. requestAirportPickup writes this document
      // and airportProfiles together, and updateAirportPickup transitions it inside a
      // transaction so two Sarthis cannot both be told they claimed it. Neither is
      // something a client can do atomically, so a client may not do it at all.
      //
      // create/update/delete listed separately rather than `write`, because `write`
      // silently includes delete and an OR'd `allow delete: if false` cannot take it
      // back. Both callables run on the Admin SDK and bypass this entirely.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // =====================================
    // AIRPORT SEVA — the durable traveller record
    // =====================================
    //
    // Keyed by uid, one per traveller, and it OUTLIVES the trip. It is the source for
    // the Airport scope of the member export and the "database used for other
    // purposes" the service was asked for.
    //
    // CLOSED TO SARTHIS, unlike the board above. It holds an exact date of birth and
    // a family contact for every traveller who has ever asked, including people whose
    // trip finished months ago and including minors. A Sarthi needs the passenger
    // details for the trip in front of them, and those are snapshotted onto the trip
    // itself — so there is nothing here they need and a great deal they do not.
    //
    // COORDINATOR, not isManagerForRead(). This is the one place the flag is a real
    // read gate, and the one place it can be: there is no Sarthi arm here for the
    // hierarchy to defeat. A manager who runs Friday nights has no reason to hold a
    // traveller's date of birth, and isManagerForRead() would additionally accept a
    // token claim that survives a demotion for up to an hour — fine for a rider list,
    // not for this.
    //
    // The cost, accepted: one document read per request instead of a free token check,
    // and until somebody is made a coordinator no manager can read this collection at
    // all. Neither is a dead control, because the oversight panel and the Airport
    // export are gated on the same flag in the UI — nothing is shown that cannot work.
    //
    // Read is not narrowed by resource.data, which keeps it list-safe: the export
    // reads it as a collection query, and a condition that inspects the document makes
    // a whole query fail. Same trap as /feedback and /notices.
    match /airportProfiles/{uid} {
      allow read: if isOwner(uid) || isAirportCoordinator();

      // Written only by requestAirportPickup, on the Admin SDK.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // =====================================
    // SETTINGS COLLECTION (Sabha location, etc.)
    // =====================================
    match /settings/{settingId} {
      // settings/main (the venue) must stay readable — it drives the map and
      // the pickup destination for every user.
      //
      // settings/managerCode must NOT. Reading it is equivalent to becoming a
      // manager: the signup flow accepts the code and self-approves. It was
      // world-readable to any signed-in account, and rendered as plain text in
      // the Database Console.
      // settings/managerCode is gone, and its rule with it. It held one shared,
      // never-expiring access code that any approved manager could read in
      // plaintext and hand out indefinitely, with nothing recording that they
      // had. Replaced by managerInvites, which no client can read at all.
      //
      // Everything else under settings/ is the venue and schedule, which every
      // signed-in user needs in order to see where and when sabha is.
      allow read: if isAuthenticated();

      // create + update, NOT `write`, for the same reason as statistics above.
      // settings/main holds the venue that drives the map and the pickup destination
      // for every user; a manager deleting it takes the whole app's geography with
      // it, and OR'd allow rules mean a delete denial below could not have stopped it.
      allow create, update: if isManager();
      allow delete: if false;
    }
  }
}
