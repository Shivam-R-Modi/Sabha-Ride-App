rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// Bhulka Gaadi — Cloud Storage
//
// This is the FIRST Storage rules file in this project. Nothing uploaded
// anything before notice-board images, so there is no prior behaviour to
// preserve — and no prior template, which is why the manager check below is
// written to mirror `firestore.rules` deliberately rather than approximately.
//
// Two things this file is guarding:
//
//   1. Only an approved manager may put a file here. Storage has no notion of
//      this app's roles, so the check crosses into Firestore for the caller's
//      user document. It reads `role`, `registeredRole` AND `roles[]`, because a
//      recorded role may live in any of the three — see `recordsRole()` in
//      firestore.rules. A single `role == 'manager'` test would silently miss a
//      manager recorded only in the array.
//
//   2. Size and content type, ENFORCED HERE and not only in the client. The
//      composer checks both for a decent error message, but a client is a trust
//      boundary even when it belongs to a manager.
//
// Reads require a signed-in account. A notice is an announcement to the
// congregation, not public content, and an unguarded download URL would outlive
// the notice that was deleted.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    // Identical reads are cached within one rules evaluation, so calling this
    // more than once below costs a single Firestore read.
    function callerData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    // The claim test — kept as a FALLBACK, not the primary. Mirrors
    // isManagerToken() in firestore.rules.
    //
    // THE BUG THIS WAS ADDED FOR, AND ITS RESOLVED CAUSE
    //
    // isApprovedManager() below reads the caller's user document with
    // `firestore.get()` — a CROSS-SERVICE rule. That read failed for the whole life
    // of the notice board: `.data` on a failed get errors, an errored condition
    // denies, so posting a notice WITH AN IMAGE returned `storage/unauthorized` for
    // every manager. Text-only notices were unaffected, being plain Firestore
    // writes, which is why the board looked like it worked.
    //
    // The cause, established by measurement on 2026-08-24 after two wrong guesses:
    // **the Cloud Storage for Firebase service agent had no Firestore permission at
    // all.** Storage rules are evaluated in that service's context, and its own
    // role, `roles/firebasestorage.serviceAgent`, contains zero datastore
    // permissions. Granting `roles/firebaserules.firestoreServiceAgent` to
    // `service-<project-number>@gcp-sa-firebasestorage.iam.gserviceaccount.com`
    // fixed it — 403 for two minutes while IAM propagated, then 200.
    //
    // The two wrong guesses are recorded because both are easy to repeat: it is NOT
    // the Rules agent (`service-<n>@firebase-rules...`, which already holds
    // `roles/firebaserules.system` including `datastore.entities.get`), and there is
    // no `gcp-sa-firebaserules` agent on this project at all — asking IAM to grant
    // to one answers "Service account does not exist".
    //
    // WHY THE DOCUMENT ARM IS NOW FIRST
    //
    // Because it is the stronger of the two and it works. It re-reads the user
    // document on every upload, so a demotion takes effect at once; the claim arm
    // cannot do that. That immediacy was the entire point of chasing the IAM grant,
    // and leaving the claim first would have thrown it away — the cheap arm would
    // keep answering before the correct one was ever consulted.
    //
    // The claim stays behind it as a fallback rather than being deleted. If that
    // IAM binding is ever removed — a project migration, someone tidying IAM — the
    // document arm starts erroring again, and `||` lets the claim answer instead.
    // Uploads degrade to "revocation lags by up to an hour" rather than failing
    // outright with a message nobody can act on. That is the failure mode this repo
    // keeps removing, and one line prevents it.
    //
    // THE TRADE ON THE FALLBACK, STATED
    //
    // A custom claim lives on an ID token for up to an hour after a demotion, and
    // this arm does not look at `accountStatus`. While it is only a fallback, that
    // window is now unreachable in normal operation. It would be unacceptable for
    // reading rider data — see isManagerForRead() in firestore.rules — and is
    // acceptable here: an uploaded image is inert until a notice points at it, and
    // `publishNotice` re-reads the user document through assertApprovedManager
    // before it will publish one. The worst case is an orphaned file, which
    // `deleteNotice` and `expireNotices` already sweep.
    //
    function isManagerToken() {
      return signedIn() && request.auth.token.get('mgr', false) == true;
    }

    // Mirrors recordsRole() + isApprovedAs('manager') in firestore.rules.
    //
    // firestore.rules routes isManager() through grantsRole(), not recordsRole().
    // For 'manager' the two are EQUIVALENT — grantsRole's extra clauses only
    // fire when the role asked for is 'student' or 'driver' (the hierarchy
    // expands downward, so a manager grants those). Checked, not assumed.
    // NOT a custom claim: a claim survives on an ID token for up to an hour
    // after a demotion, and the same reasoning is recorded in
    // functions/src/utils/authz.ts.
    function isApprovedManager() {
      return signedIn()
             && callerData().accountStatus == 'approved'
             && (
               callerData().role == 'manager'
               || callerData().registeredRole == 'manager'
               || ('roles' in callerData()
                   && callerData().roles != null
                   && 'manager' in callerData().roles)
             );
    }

    function isReasonableImage() {
      // 3 MB is comfortably more than a phone photo compressed for a flyer, and
      // small enough that a mistake cannot fill the bucket.
      return request.resource.size < 3 * 1024 * 1024
             && request.resource.contentType.matches('image/.*');
    }

    // Notice-board images. One folder per notice so deleting the notice can
    // delete its file — the document stores the PATH as well as the download
    // URL, because a URL alone cannot be deleted.
    match /notices/{noticeId}/{fileName} {
      allow read: if signedIn();

      // create + update, NOT `write`. `write` expands to create, update AND
      // delete, and allow statements are OR'd — so a `write` grant here would
      // hand managers a direct delete that the `allow delete: if false` below
      // could not take back. It would still have failed in practice, because
      // isReasonableImage() reads request.resource, which is null on a delete,
      // and an errored condition denies. Security by accident is not security:
      // naming the two methods makes the denial below the actual reason.
      // Document arm FIRST, claim second: see the comment on isManagerToken().
      // The document read honours a demotion immediately; the claim is the fallback
      // that keeps uploads working if the cross-service IAM binding is ever lost.
      // Either arm proves the caller is a manager; isReasonableImage() still gates
      // the file itself in both cases, because a manager's client is still a client.
      allow create, update: if (isApprovedManager() || isManagerToken())
                               && isReasonableImage();

      // Deletion goes through the deleteNotice callable, which removes the file
      // and the document together. A client delete could strand one without the
      // other — the same reasoning that makes `events` undeletable from the
      // client in firestore.rules.
      allow delete: if false;
    }

    // Everything else is closed. There is no other upload surface in this app,
    // and a default-open bucket on a project holding children's data is not a
    // mistake worth leaving room for.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
